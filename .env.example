DATABASE_URL=postgresql+psycopg://lexetta:lexetta_dev@localhost:5432/lexetta
UPLOAD_DIR=./uploads
OPENAI_API_KEY=

# --- Modal credentials (required wherever the app RUNS) -----------------------
# The LCP model runs on a Modal GPU container; the app calls it over Modal RPC.
# Locally `modal setup` writes ~/.modal.toml and these can stay empty. In Docker
# there is no such file, so the container authenticates with these instead —
# without them every prediction fails and pages silently show no highlights.
# Create a pair with:  modal token new
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- LCP model config (only used when DEPLOYING the model) --------------------
# Read from this file by modal_deploy.py, which pushes them into the `lcp-model`
# Modal secret. The web process never reads them, so they may be left empty on
# the server. Run `python modal_deploy.py` after changing any of them.
# Local path or Hugging Face Hub repo id of the trained LCP model
# (e.g. ./models/lcp or my-org/my-adapter)
LCP_MODEL_DIR=
# Hugging Face token for loading a private Hub repo (optional)
LCP_MODEL_TOKEN=
# Branch, tag, or commit hash to load from the Hub (optional)
LCP_MODEL_REVISION=